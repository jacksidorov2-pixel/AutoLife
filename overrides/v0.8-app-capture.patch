+    private void handleAppCaptureIntent(Intent intent) {
+        if (intent == null || !ACTION_CAPTURE_APP.equals(intent.getAction())) return;
+
+        String pkg = intent.getStringExtra(EXTRA_CAPTURE_PACKAGE);
+        String title = intent.getStringExtra(EXTRA_CAPTURE_TITLE);
+        if (pkg == null || pkg.isBlank()) return;
+
+        pendingAppCapturePackage = pkg;
+        pendingAppCaptureTitle = (title == null || title.isBlank()) ? pkg : title;
+        setStatus(pendingAppCaptureTitle + " • запускаю на телефоне для app-capture");
+
+        Intent launch = getPackageManager().getLaunchIntentForPackage(pkg);
+        if (launch == null) {
+            setStatus(pendingAppCaptureTitle + " не установлено");
+            pendingAppCapturePackage = null;
+            pendingAppCaptureTitle = null;
+            return;
+        }
+        launch.addFlags(Intent.FLAG_ACTIVITY_REORDER_TO_FRONT);
+        startActivity(launch);
+
+        // Android 14+ app-screen sharing is selected by the user in the system consent UI.
+        // We deliberately do not use createConfigForDefaultDisplay(), because that forces
+        // full-screen mirroring. The default chooser offers "one app".
+        new Handler(Looper.getMainLooper()).postDelayed(this::requestAppScreenCapture, 450L);
+    }
+
+    private void requestAppScreenCapture() {
+        if (captureRequestPending || pendingAppCapturePackage == null) return;
+        captureRequestPending = true;
+        MediaProjectionManager manager =
+                (MediaProjectionManager) getSystemService(MEDIA_PROJECTION_SERVICE);
+        Intent consent = manager.createScreenCaptureIntent();
+        startActivityForResult(consent, RC_APP_CAPTURE);
     }
 
